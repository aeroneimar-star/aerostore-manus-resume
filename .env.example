# App
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
AEROSTORE_PUBLIC_BASE_URL=
AEROSTORE_BASE_URL=http://localhost:3000
AEROSTORE_INSTANCE_CONFIG=
AEROSTORE_CASHBACK_TIMEZONE=America/Sao_Paulo
DATABASE_PATH=

# Security
# Replace every value below before staging or production.
SESSION_SECRET=troque_este_valor
JWT_SECRET=troque_este_valor
PDV_TOTP_SECRET=
AUTH_SECRET=
APP_SECRET=
CASHBACK_PIN_PEPPER=troque_este_valor

# PagBank
# Staging must remain in sandbox until production credentials are approved.
PAGBANK_ENV=sandbox
PAGBANK_SANDBOX_TOKEN=
PAGBANK_PRODUCTION_TOKEN=
PAGBANK_PUBLIC_KEY=
PAGBANK_WEBHOOK_SECRET=trocar-em-producao
PAGBANK_WEBHOOK_URL=
PAGBANK_REDIRECT_URL=
PAGBANK_RETURN_URL=
PAGBANK_INSTALLMENTS_LIMIT=10
PAGBANK_INTEREST_FREE_INSTALLMENTS=1
PAGBANK_SOFT_DESCRIPTOR=AEROSTORE

# WhatsApp CRM
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_MODE=legacy
WHATSAPP_SESSION_PATH=
WHATSAPP_PROTOCOL_TIMEOUT_MS=240000
WHATSAPP_SEND_HEALTH_TIMEOUT_MS=25000
WHATSAPP_BOOTSTRAP_TIMEOUT_MS=120000
PDV_WHATSAPP_SEND_TIMEOUT_MS=25000

# Argox
# The server can generate PRN files without sending them to a physical printer.
ARGOX_PRINT_ENABLED=false
ARGOX_PRINTER_NAME=Argox OS-214plus
ARGOX_PRINTER_MODEL=Argox OS-214plus
ARGOX_LABEL_LANGUAGE=PPLA
ARGOX_DPI=203
ARGOX_LABEL_WIDTH_MM=40
ARGOX_LABEL_HEIGHT_MM=60
ARGOX_LABEL_COLUMNS=2
ARGOX_LABEL_GAP_MM=3
ARGOX_DEFAULT_TEMPLATE=aerostore_tag_40x60_2c

# Uploads
UPLOAD_MAX_FILE_SIZE_MB=5
PRODUCT_UPLOAD_DIR=public/uploads/products

# Tiny and external integrations
TINY_TOKEN=
TINY_ENV=

# AI
OPENAI_API_KEY=
AI_PROVIDER=
AI_MODEL=
