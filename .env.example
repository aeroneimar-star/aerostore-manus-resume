# Shop / e-commerce (Deploy A1)
# false = catálogo público OFF (/catalogo, /produto, /public-api/*). CRM admin read-only continua ON.
SHOP_PUBLIC_CATALOG_ENABLED=false

# App
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
AEROSTORE_PUBLIC_BASE_URL=https://aerostore.site
AEROSTORE_PUBLIC_SITE_HOST=aerostore.site,www.aerostore.site
AEROSTORE_CRM_HOST=crm.aerostore.site
AEROSTORE_BASE_URL=http://localhost:3000
AEROSTORE_INSTANCE_CONFIG=
AEROSTORE_CASHBACK_TIMEZONE=America/Sao_Paulo
DATABASE_PATH=

# Fiscal module (Stage 1 foundation — no SEFAZ/provider/certificate)
# Keep false until Stage 2+. When false, completed sales never create fiscal requests.
FISCAL_MODULE_ENABLED=false
# FISCAL_DEFAULT_ENVIRONMENT=homologacao
# FISCAL_DEFAULT_MODEL=65

# Security
# Replace every value below before staging or production.
SESSION_SECRET=troque_este_valor
JWT_SECRET=troque_este_valor
PDV_TOTP_SECRET=
AUTH_SECRET=
APP_SECRET=
CASHBACK_PIN_PEPPER=troque_este_valor

# PagBank
# Staging must remain in sandbox until production credentials are approved.
PAGBANK_ENV=sandbox
PAGBANK_SANDBOX_TOKEN=
PAGBANK_PRODUCTION_TOKEN=
PAGBANK_PUBLIC_KEY=
PAGBANK_WEBHOOK_SECRET=trocar-em-producao
PAGBANK_WEBHOOK_URL=
PAGBANK_REDIRECT_URL=
PAGBANK_RETURN_URL=
PAGBANK_INSTALLMENTS_LIMIT=10
PAGBANK_INTEREST_FREE_INSTALLMENTS=1
PAGBANK_SOFT_DESCRIPTOR=AEROSTORE

# Provider ativo de pagamento por link (infinitepay | pagbank).
# Em staging/producao, mantenha pagbank enquanto INFINITEPAY_HANDLE/REDIRECT/WEBHOOK
# nao apontarem para um dominio publico real.
PAYMENT_PROVIDER=pagbank
# Tag InfinitePay sem o simbolo $ (ex.: minhaloja).
INFINITEPAY_HANDLE=
# URL publica para onde o cliente volta apos pagar (frontend AEROSTORE).
# Em staging/producao, use dominio publico real: https://SEU_DOMINIO/pdv/pagamento/infinitepay/retorno
INFINITEPAY_REDIRECT_URL=https://SEU_DOMINIO/pdv/pagamento/infinitepay/retorno
# URL publica do webhook InfinitePay (backend AEROSTORE).
# Em staging/producao, use dominio publico real: https://SEU_DOMINIO/api/pdv/payments/infinitepay/webhook
INFINITEPAY_WEBHOOK_URL=https://SEU_DOMINIO/api/pdv/payments/infinitepay/webhook

# WhatsApp CRM
WHATSAPP_PROVIDER=web
WHATSAPP_ENABLED=false
WHATSAPP_WEB_ENABLED=false
WHATSAPP_AUTH_MODE=legacy
WHATSAPP_SESSION_PATH=
WHATSAPP_PROTOCOL_TIMEOUT_MS=240000
WHATSAPP_SEND_HEALTH_TIMEOUT_MS=25000
WHATSAPP_BOOTSTRAP_TIMEOUT_MS=120000
PDV_WHATSAPP_SEND_TIMEOUT_MS=25000

# WhatsApp Cloud API (Meta)
# Keep enabled=false and dry-run=true until the official token is configured on the server.
# NUNCA commite credenciais reais. Token, app secret e verify token sao sensiveis.
# Os dois blocos abaixo sao aceitos como aliases (atalho novo + nome canonico legado).
# O resolver prioriza o atalho, mas mantem retrocompatibilidade com o nome canonico.

# --- Bloco atalho novo (preferido) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=aerostore_verify
WHATSAPP_APP_SECRET=
WHATSAPP_APP_ID=
WHATSAPP_CLOUD_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_API_VERSION=v24.0

# --- Bloco canonico legado (retrocompativel) ---
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=

WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_TEMPLATE_CASHBACK=cashback_notificacao
WHATSAPP_TEMPLATE_AVISO_10=cashback_aviso_10dias
WHATSAPP_TEMPLATE_AVISO_3=cashback_aviso_3dias
NOTIFICATION_CHANNEL=whatsapp
NOTIFICATION_DRY_RUN=true
NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_CASHBACK_BATCH_LIMIT=50
NOTIFICATION_ENFORCE_BUSINESS_HOURS=true

# Argox
# Impressao fisica via agente local Windows (PPLA/PPLB RAW). O servidor gera PRN/payload e o browser fala com o agente.
ARGOX_PRINT_ENABLED=false
ARGOX_PRINTER_MODEL=Argox OS-214plus
# Linguagem configurada no PDV/payload (PPLA ou PPLB)
ARGOX_LANGUAGE=PPLB
ARGOX_LABEL_LANGUAGE=PPLB
# Linguagem RAW realmente enviada a impressora (override quando fila Windows diz PPLA mas hardware executa PPLB/EPL-like)
ARGOX_PHYSICAL_LANGUAGE=PPLB
ARGOX_PRINTER_NAME=Argox OS-214 plus series PPLA
ARGOX_AGENT_URL=http://localhost:4000
ARGOX_AGENT_PORT=4000
# Em casa, sem impressora: true simula impressao e salva .prn em agente-impressao-argox/output/
ARGOX_AGENT_DRY_RUN=false
# RAW = WritePrinter RAW | WINDOWS_DRIVER = bitmap via driver normal (recomendado nesta OS-214)
ARGOX_PRINT_TRANSPORT=WINDOWS_DRIVER
# Ajuste fino da impressao via driver (defaults seguros = 1 / 0)
ARGOX_DRIVER_SCALE_X=1
ARGOX_DRIVER_SCALE_Y=1
ARGOX_DRIVER_OFFSET_X_MM=0
ARGOX_DRIVER_OFFSET_Y_MM=0
# true = desenha borda/linhas centrais no PNG dry-run
ARGOX_DRIVER_DEBUG_BORDER=false
# Confirmacao obrigatoria para scripts de impressao real (send_argox_prn_real.js, testes minimos)
ARGOX_CONFIRM_REAL_PRINT=false
# true = forca quantidade final 1 em qualquer impressao real via agente (recomendado na loja)
ARGOX_SAFE_TEST_MODE=true
ARGOX_DPI=203
ARGOX_LABEL_WIDTH_MM=40
ARGOX_LABEL_HEIGHT_MM=60
ARGOX_LABEL_PRICE_BAND_MM=12
ARGOX_LABEL_GRID=1x1
ARGOX_PRINT_CELL=top-left
ARGOX_DRIVER_SCALE_X=1
ARGOX_DRIVER_SCALE_Y=1
ARGOX_DRIVER_OFFSET_X_MM=0
ARGOX_DRIVER_OFFSET_Y_MM=0
ARGOX_DRIVER_DEBUG_BORDER=false
ARGOX_LABEL_COLUMNS=2
ARGOX_LABEL_GAP_MM=3
ARGOX_DEFAULT_TEMPLATE=aerostore_tag_40x60_2c

# Uploads
UPLOAD_MAX_FILE_SIZE_MB=5
PRODUCT_UPLOAD_DIR=public/uploads/products

# Tiny and external integrations
TINY_TOKEN=
TINY_ENV=

# AI
OPENAI_API_KEY=
AI_PROVIDER=
AI_MODEL=

# App phone OTP (pepper longo e secreto; obrigatorio para usar os endpoints)
APP_OTP_PEPPER=
# Segredos independentes com pelo menos 32 caracteres; nunca expor ao app
APP_JWT_SECRET=
APP_SESSION_PEPPER=
APP_PROFILE_SECRET=
APP_OTP_DRY_RUN=false
WHATSAPP_TEMPLATE_APP_OTP=aerostore_app_otp
WHATSAPP_TEMPLATE_LANG=pt_BR

# Contingencia SMS via Twilio Verify; sem estas tres variaveis o WhatsApp continua ativo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
