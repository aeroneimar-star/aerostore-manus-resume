{
  "expo": {
    "name": "AEROSTORE",
    "slug": "aerostore",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aerostore",
    "userInterfaceStyle": "dark",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
