# Agente Argox local — copie para .env nesta pasta (opcional)
# Variaveis tambem podem ser passadas no PowerShell antes de node server.js

ARGOX_AGENT_PORT=4000
ARGOX_PRINTER_NAME=Argox OS-214 plus series PPLA

# PPLA = envelope STX L (alguns drivers)
# PPLB = envelope EPL-like N/q/Q/P (esta instalacao fisica OS-214 Plus)
ARGOX_LANGUAGE=PPLB

# Override do RAW fisico: use PPLB mesmo que a fila Windows se chame "... PPLA"
ARGOX_PHYSICAL_LANGUAGE=PPLB

# true = forca quantidade final 1 em qualquer impressao real (recomendado na loja)
ARGOX_SAFE_TEST_MODE=true

# true  = simula impressao e salva .prn em output/ (casa ou teste seguro)
# false = envia para a fila Windows da Argox (loja)
ARGOX_AGENT_DRY_RUN=false

# RAW = WritePrinter RAW | WINDOWS_DRIVER = bitmap via driver normal (recomendado nesta OS-214)
ARGOX_PRINT_TRANSPORT=WINDOWS_DRIVER
ARGOX_LABEL_GRID=1x1
ARGOX_DRIVER_SCALE_X=1
ARGOX_DRIVER_SCALE_Y=1
ARGOX_DRIVER_OFFSET_X_MM=0
ARGOX_DRIVER_OFFSET_Y_MM=0
ARGOX_DRIVER_DEBUG_BORDER=false

# Colunas fisicas por linha no WINDOWS_DRIVER (2 = 80x60mm / 640x480, 1 = fallback 40x60mm)
ARGOX_DRIVER_COLUMNS=2

# Origens permitidas no CORS (separadas por virgula)
ARGOX_AGENT_ORIGINS=localhost,127.0.0.1,aerostore
